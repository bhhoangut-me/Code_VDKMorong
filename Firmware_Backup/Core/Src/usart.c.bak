#include "usart.h"
#include "string.h"
#include <stdio.h>
#include "cmsis_os2.h"
/* USER CODE BEGIN 0 */
uint8_t ESP_SendCommand(const char *cmd,
                        const char *expected,
                        uint32_t timeout)
{
    char rxBuf[256] = {0};
    uint8_t ch;
    uint16_t index = 0;

    uint32_t startTick = HAL_GetTick();

    /* Send command */
    HAL_UART_Transmit(
        &huart1,
        (uint8_t *)cmd,
        strlen(cmd),
        1000
    );

    /* Wait response */
    while ((HAL_GetTick() - startTick) < timeout)
    {
        if (HAL_UART_Receive(
                &huart1,
                &ch,
                1,
                10
            ) == HAL_OK)
        {
            if (index < sizeof(rxBuf) - 1)
            {
                rxBuf[index++] = ch;
                rxBuf[index] = '\0';
            }

            if (strstr(rxBuf, expected) != NULL)
            {
                return 1;
            }

            if (strstr(rxBuf, "ERROR") != NULL)
            {
                return 0;
            }
        }
    }

    return 0;
}


/* =========================================================
 * 2. INIT ESP + CONNECT TCP
 * ========================================================= */
uint8_t ESP_Init(const char *serverIP,
                 uint16_t port)
{
    char cmd[100];

    /* Test ESP */
    if (!ESP_SendCommand(
            "AT\r\n",
            "OK",
            1000))
    {
        return 0;
    }

    /* Station mode */
    if (!ESP_SendCommand(
            "AT+CWMODE=1\r\n",
            "OK",
            1000))
    {
        return 0;
    }

    /* Single connection */
    if (!ESP_SendCommand(
            "AT+CIPMUX=0\r\n",
            "OK",
            1000))
    {
        return 0;
    }

    /* Connect TCP */
    /* Close any existing connection */
    ESP_SendCommand("AT+CIPCLOSE\r\n", "OK", 1000);
    osDelay(500);

    snprintf(
        cmd,
        sizeof(cmd),
        "AT+CIPSTART=\"TCP\",\"%s\",%u\r\n",
        serverIP,
        port
    );

    if (!ESP_SendCommand(
            cmd,
            "OK",
            10000))
    {
        return 0;
    }

    return 1;
}


/* =========================================================
 * 3. SEND DATA TCP
 * ========================================================= */
uint8_t ESP_SendData(const char *data)
{
    char cmd[32];

    uint16_t len = strlen(data);

    /* AT+CIPSEND=len */
    snprintf(
        cmd,
        sizeof(cmd),
        "AT+CIPSEND=%u\r\n",
        len
    );

    /* ESP ph?i tr? d?u > */
    if (!ESP_SendCommand(
            cmd,
            ">",
            2000))
    {
        return 0;
    }

    /* G?i payload */
    HAL_UART_Transmit(
        &huart1,
        (uint8_t *)data,
        len,
        1000
    );

    /*
     * B?n don gi?n n�y chua ch? SEND OK ? d�y.
     * Mu?n chu?n hon c� th? th�m receive response sau.
     */


    /* Cho SEND OK */
    ESP_SendCommand("", "SEND OK", 2000);
    return 1;
}
